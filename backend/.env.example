DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pc_recommender
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=86400

# 管理接口鉴权（请求头：X-Admin-Token）
ADMIN_TOKEN=change-me

# 允许的前端 Origin（逗号分隔）。开发默认：Vite 5173。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GZip 压缩阈值（字节）。配置 JSON 较大时可显著减少传输体积。
GZIP_MINIMUM_SIZE=1000

